# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # само server-side!
# Shared RPC override (optional); method-specific settings take precedence
SOLANA_RPC_URL=
# Transactions/signatures default to PublicNode; holder/account requests default to Solana public RPC.
SOLANA_TRAFFIC_RPC_URL=
SOLANA_HOLDER_RPC_URL=
# Telegram (по избор)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Алерти (USD)
ALERT_BIG_TRADE_USD=5000
ALERT_WHALE_PCT=1.0
# Защита на /api/tokens/bootstrap
ADMIN_SECRET=

# Server-side ingestion; optional authenticated POST endpoint
CRON_SECRET=
MARKET_HOLDER_BUDGET=2

# Recovery only; keep false on Vercel Hobby. Background ingestion runs in Supabase.
ALLOW_VERCEL_INGEST=false
